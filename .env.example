# Non-sensitive server configuration. The switch remains available in both modes.
COMPASS_DEFAULT_MODE=demo
GEMINI_MODEL=google/gemini-3.8-flash
JEV_MODEL=typesafe-ai/jev-1.14.0
# Private values intentionally blank. Enter real values only in the hosting
# dashboard or an ignored .env.local file. Never use a NEXT_PUBLIC_ prefix.
# Vercel may use its automatically injected OIDC token instead of a Gateway key.
AI_GATEWAY_API_KEY=
# Optional shared Studio access key. Blank means this app-level gate is disabled.
# This is not account authentication. Protect hosted testing separately.
COMPASS_ACCESS_TOKEN=
# Do not create or commit VERCEL_OIDC_TOKEN manually. It is platform-managed.
