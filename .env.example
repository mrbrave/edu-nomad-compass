# Server-only configuration. Never commit a populated copy.
COMPASS_DEFAULT_MODE=demo
STUDIO_ENABLE_LIVE=false
STUDIO_ACCESS_TOKEN=

# Model A: direct TypeSafe evaluator
EVALUATOR_PROVIDER=typesafe
TYPESAFE_API_KEY=
EVALUATOR_MODEL=jev-1.14.0

# Model B: direct Gemini Developer API
GENERATOR_PROVIDER=gemini
GEMINI_API_KEY=
GENERATOR_MODEL=gemini-3.8-flash
GENERATOR_BILLING_TIER=paid

# Authenticated persistence adapter. The database owns allocations and balances.
STUDIO_LEDGER_URL=
STUDIO_LEDGER_TOKEN=
TENANCY_MODE=single-workspace
ENABLE_POST_REPLY_ASSESSMENT=true
ENABLE_ADMIN_PROVIDER_SETTINGS=false

# Existing Compass pilots may retain COMPASS_ACCESS_TOKEN as an access-code alias.
# SESSION_SIGNING_SECRET and SECRET_MANAGER_REF are reserved for future session/vault work.
# DATABASE_URL is unnecessary with the supplied HTTPS ledger adapter.
# STUDIO_BUDGET_USD is a provisioning concept: create an audited allocation in the ledger.
# It is never a runtime balance or a provider prepaid-balance reader.
