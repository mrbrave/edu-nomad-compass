# Independent EduNomad configuration. Never copy another application's env files.
# Vercel deployments can use their own automatically injected OIDC token.
# Local development may use an AI Gateway API key entered in .env.local.
AI_GATEWAY_API_KEY=
GEMINI_MODEL=google/gemini-3.8-flash
JEV_MODEL=typesafe-ai/jev-1.14.0
# Optional extra access key. Vercel Authentication should protect hosted previews.
COMPASS_ACCESS_TOKEN=
